{
  "proactive_enabled": {
    "description": "识海主动开口",
    "type": "bool",
    "default": true,
    "hint": "念头 u(t) 攒满阈值后，核心发 fire_pending，行为插件（shihai_behavior）按涌现规则生成一句话发给主人（论文§5.6/§9/§12）。离线模式.bat 会自动暂存行为插件省 token。"
  },
  "owner_only_feedback": {
    "description": "只对主人做反馈自适应",
    "type": "bool",
    "default": true,
    "hint": "θ 在线学习（§11 反馈信号表）只吃主人的消息；群友的'嗯哦'不会让她变冷淡。"
  },
  "owner_only_perception": {
    "description": "只把主人的消息写进心智图谱",
    "type": "bool",
    "default": true,
    "hint": "开启后非 owner_qid 的会话消息不进入全局情绪场/记忆图谱，避免别人的话被召回后注入到主人的对话。若确实要让她记住群友，关掉此项；关掉后需同时接受群聊内容会进入同一图谱。"
  },
  "tick_seconds": {
    "description": "心跳步长（秒）",
    "type": "int",
    "default": 60,
    "hint": "每多少秒推进一次 ODE/图谱衰减/念头积累。60 秒是论文动力学的时间粒度，最小 30。"
  },
